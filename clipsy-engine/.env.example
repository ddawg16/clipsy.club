# --- database -------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- whop (API tier — cheapest, most durable) ------------------------------
WHOP_API_KEY=
# The endpoint that returns campaign/bounty listings for your account.
# Not sure which one? npm run discover -- https://whop.com/<your campaigns page>
WHOP_ENDPOINT=

# --- clipping.net ---------------------------------------------------------
# Tier 1: the JSON endpoint the campaigns page hydrates from.
#   npm run discover -- https://clipping.net/campaigns
CLIPPINGNET_FEED_URL=
# Tier 2 fallback: render this page with Playwright if no feed URL is set.
CLIPPINGNET_PAGE_URL=https://clipping.net/campaigns
# Only if the listing requires a logged-in session.
CLIPPINGNET_COOKIE=

# --- behaviour ------------------------------------------------------------
MISSING_RUNS_BEFORE_PULLED=2
USER_AGENT=ClipsyBot/0.1 (+https://clipsy.club/bot; campaign indexer; contact@clipsy.club)
PORT=8787

# --- deploy ---------------------------------------------------------------
CRON_SECRET=generate-a-long-random-string

# --- API security (REQUIRED — writes fail closed without these) -----------
# openssl rand -hex 32
API_WRITE_TOKEN=
# Exact origins allowed to call the API from a browser. No wildcards, no trailing slash.
ALLOWED_ORIGINS=https://clipsy.club,https://www.clipsy.club
