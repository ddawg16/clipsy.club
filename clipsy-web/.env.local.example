# The ANON key is safe here — it is protected by Row Level Security.
# NEVER put SUPABASE_SERVICE_KEY in this file: NEXT_PUBLIC_* is shipped to browsers.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where "Join the Discord" points.
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/YOUR-INVITE

# Public origin of the authenticated Clip Campaign Manager. This URL is safe
# to expose; credentials and API keys are not.
NEXT_PUBLIC_CLIPSY_DASHBOARD_URL=https://api.clipsy.club

# Server-only public API integration. Never add NEXT_PUBLIC_ to the key.
CLIPSY_API_BASE_URL=https://api.clipsy.club
CLIPSY_API_KEY=ck_replace_with_a_scoped_key
